{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin/pages/:id",
      "destination": "/admin/pages/[id]"
    },
    {
      "source": "/admin/articles/:id",
      "destination": "/admin/articles/[id]"
    }
  ],
  "crons": [
    {
      "path": "/api/report-digest",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/report-digest-weekly",
      "schedule": "0 2 * * 1"
    },
    {
      "path": "/api/report-digest-monthly",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/api/site-health-check",
      "schedule": "*/30 * * * *"
    }
  ]
}
