{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "suiyuecare.com"
        }
      ],
      "destination": "https://www.suiyuecare.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "login.suiyuecare.com"
        }
      ],
      "destination": "/portal/"
    },
    {
      "source": "/admin/pages/:id",
      "destination": "/admin/pages/[id]"
    },
    {
      "source": "/admin/articles/:id",
      "destination": "/admin/articles/[id]"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/404/"
    }
  ],
  "crons": [
    {
      "path": "/api/report-digest",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/report-digest-weekly",
      "schedule": "0 2 * * 1"
    },
    {
      "path": "/api/report-digest-monthly",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/api/site-health-check",
      "schedule": "0 4 * * *"
    }
  ]
}
