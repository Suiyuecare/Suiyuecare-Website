{
  "name": "suiyuecare-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/generate-static-routes.mjs && node scripts/prune-unused-public-assets.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "audit:images": "node scripts/audit-images.mjs",
    "audit:images:all": "node scripts/audit-images.mjs --all",
    "audit:images:unused": "node scripts/audit-images.mjs --unused",
    "audit:images:strict": "node scripts/audit-images.mjs --strict",
    "articles:stroke:charts": "node scripts/generate-stroke-series-charts.mjs",
    "articles:redirects:sync": "node scripts/sync-article-redirects.mjs",
    "verify:article-redirects": "node scripts/sync-article-redirects.mjs --check",
    "verify:article-urls": "node scripts/verify-article-public-urls.mjs",
    "verify:route-inventory": "node scripts/verify-route-inventory.mjs",
    "verify:cms-contract": "node scripts/verify-cms-contract.mjs",
    "verify:cms-fallbacks": "node scripts/verify-cms-fallback-snapshot.mjs",
    "verify:cms-fallbacks:live": "node scripts/sync-cms-fallbacks.mjs --check",
    "verify:department-access": "node scripts/verify-department-access.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:public-content-seo": "node scripts/verify-public-content-seo.mjs",
    "verify:public-content-rebuild": "node scripts/verify-public-content-rebuild.mjs",
    "verify:routes:production": "node scripts/verify-production-routes.mjs",
    "verify:copy": "node scripts/verify-copy.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:accessibility": "node scripts/verify-accessibility.mjs",
    "verify:performance": "node scripts/verify-performance.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:security:production": "VERIFY_PRODUCTION=1 node scripts/verify-security.mjs",
    "verify:production": "pnpm verify:routes:production && pnpm verify:security:production",
    "verify:all": "pnpm build && pnpm verify:article-urls && pnpm verify:article-redirects && pnpm verify:route-inventory && pnpm verify:cms-contract && pnpm verify:cms-fallbacks && pnpm verify:department-access && pnpm verify:routes && pnpm verify:public-content-seo && pnpm verify:public-content-rebuild && pnpm verify:copy && pnpm verify:seo && pnpm verify:links && pnpm verify:accessibility && pnpm verify:performance && pnpm verify:security && pnpm audit:images:strict",
    "cms:fallbacks:sync": "node scripts/sync-cms-fallbacks.mjs",
    "backup:supabase": "node scripts/backup-supabase.mjs",
    "restore:supabase": "node scripts/restore-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "lucide": "^1.25.0"
  },
  "devDependencies": {
    "vite": "^8.0.16"
  }
}
